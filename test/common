long abi_call4(long (*fn)(long, Ty32, Ty33, long)) {
  return fn(1, (Ty32){2.5L}, (Ty33){.n = 3}, 4);
}

long double abi_call5(Ty32 (*f)(void), Ty33 (*g)(void)) {
