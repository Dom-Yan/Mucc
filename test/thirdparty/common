make="make -j$(nproc)"
# The mucc to test: ./mucc, or $MUCC (as MUCC=$PWD/build/mucc for the
# single binary).
mucc=${MUCC:-`pwd`/mucc}

# A project is a git $repo, or a release tarball at $url with its $sha256.
if [ -n "$url" ]; then
    dir=$(basename $url | sed 's/\.tar\..*//')
else
    dir=$(basename -s .git $repo)
fi

set -e -x

# Downloads go in test/thirdparty/work/ (ignored by git). The top-level
# thirdparty/ folder is for vendored code that is committed.
mkdir -p test/thirdparty/work
cd test/thirdparty/work
if [ -n "$url" ]; then
    if [ ! -d $dir ]; then
        curl -fsSLo $dir.tar.download $url
        echo "$sha256  $dir.tar.download" | sha256sum -c
        tar xf $dir.tar.download
        rm $dir.tar.download
    fi
else
    [ -d $dir ] || git clone $repo
fi
cd $dir
