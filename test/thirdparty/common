make="make -j$(nproc)"
# The mucc to test: ./mucc, or $MUCC (as MUCC=$PWD/build/mucc for the
# single binary).
mucc=${MUCC:-`pwd`/mucc}

dir=$(basename -s .git $repo)

set -e -x

# Downloads go in test/thirdparty/work/ (ignored by git). The top-level
# thirdparty/ folder is for vendored code that is committed.
mkdir -p test/thirdparty/work
cd test/thirdparty/work
[ -d $dir ] || git clone $repo
cd $dir
